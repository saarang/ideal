# ── Database ──────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ works: Supabase, Neon, Railway, RDS or self-hosted.
DATABASE_URL=postgres://ideal:ideal@localhost:5432/ideal_uniforms

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL used in Telegram reply links.
APP_BASE_URL=http://localhost:3000
# Random 32+ char string; used to sign nothing yet but reserved for cookies/CSRF.
APP_SECRET=change-me-to-a-long-random-string
# LOCAL file storage directory (created automatically). For S3/Supabase Storage
# see src/lib/storage/s3.ts and DEPLOYMENT.md.
STORAGE_DRIVER=local
DATA_DIR=./data

# ── AI document extraction ────────────────────────────────────────────────────
# 'mock' uses bundled fixtures (no network, good for demo/tests).
# 'anthropic' calls the Anthropic Messages API with vision.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Telegram ──────────────────────────────────────────────────────────────────
# 'mock' logs outgoing messages to the telegram_outbox table (dev/demo).
# 'real' talks to api.telegram.org. Set the bot token from @BotFather.
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN=
# Shared secret required on the webhook URL: /api/telegram/webhook?secret=...
TELEGRAM_WEBHOOK_SECRET=change-me
# Restrict intake to this chat/group id (optional, recommended).
TELEGRAM_ALLOWED_CHAT_ID=

# Secret for the /api/jobs/tick endpoint (used by external cron in serverless deploys)
JOBS_TICK_SECRET=change-me-too

# Set to 1 to enable the /dev Telegram simulator page (never in production)
DEV_TOOLS=1
